&CMD CmdTool=$cmd*:@switch [setq(actor,%0)][setq(trim,trim(%1))][words(%q<trim>)]=0,{@pemit %q<actor>=You must specify an object.},{@switch [setq(target,locate(%q<actor>,[%q<trim>],*))][%q<target>]=#-1,{@switch [owner([%q<trim>])]=%q<actor>,{@tr/now me/act.cmd.0=%q<trim>,%q<actor>},{@pemit %q<actor>=[u(E.FAIL.CMD.0,%q<trim>)]}},#-2,{@pemit %q<actor>=[u(E.FAIL.CMD.1,%q<trim>]},{@switch [owner([%q<target>])]=%q<actor>,{@tr/now me/act.cmd.0=[locate(%q<actor>,%q<trim>,*)],%q<actor>},{@pemit %q<actor>=[u(E.FAIL.CMD.2,%q<target>)]}}}
