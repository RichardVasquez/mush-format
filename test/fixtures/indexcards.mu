&T.CHECK_BLOCK IndexCards=@switch/now [setq(has_data,hasattr([v(indexcards_reference)],data_%0))][setq(data_id,switch(%q<has_data>,1,get([v(indexcards_reference)]/data_%0),))][setq(is_owner,switch(%q<has_data>,1,eq(owner(%q<data_id>),owner(%0)),0))][setq(answer,switch(%q<has_data>/%q<is_owner>,0/*,-1,1/0,-2,1))]%q<answer>=1,{},-1,{&data_%0 [v(indexcards_reference)]=[setq(created,create(data_block_%0,10,t))]%q<created>;@pemit [owner(%0)]=[u(u.create_data_0,%0,%1,%q<created>)]},-2,{[setq(old_data,%q<data_id>)]&data_%0 [v(indexcards_reference)]=[setq(created,create(data_block_%0,10,t))]%q<created>;@pemit [owner(%0)]=[u(u.create_data_1,%0,%1,%q<created>,%q<old_data>)]}
