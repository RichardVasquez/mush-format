&SPRAY #130=$*spray *:@pemit %0=[setq(name,[or(strmatch(v(g_name),%1),strmatch(get(me/G_ALIAS),%1))])][setq(auto,[switch(get(me/auto),YES,1,0)])][setq(drawn,[switch(get(me/LOCATION),DRAWN,1,0)])][setq(count,[gt(v(ammo_left),0)])];@swi/first [%q<name>]/[%q<auto>]/[%q<drawn>]/[%q<count>]=0/*/*/*,{@pemit %0=I don't see that gun here},*/0/*/*,{@pemit %0=Sorry, this is not an automatic gun},*/*/0/*,{@pemit %0=Maybe you should unconceal it first},*/*/*/0,{@emit/room [name(%0)] tightly squeezes the trigger and *CLICK*;},{@emit/room [name(%0)] ejects a spray of bullets toward %2 with [u(va,%0)] [v(g_name)];&AMMO_LEFT me=0}
